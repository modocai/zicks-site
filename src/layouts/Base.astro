---
import '../styles/global.css';
import {
  assetPath,
  CONTACT_EMAIL,
  DEFAULT_LOCALE,
  getDict,
  LOCALE_META,
  LOCALES,
  pageAbsUrl,
  pagePath,
  type Locale,
  type PageSlug,
} from '../i18n';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  slug: PageSlug;
  extraSchema?: object | object[] | null;
}

const {
  title,
  description,
  locale,
  slug: resolvedSlug,
  extraSchema = null,
} = Astro.props;

const dict = getDict(locale);
const meta = LOCALE_META[locale];
const siteOrigin = (Astro.site ?? new URL('https://zicks.modoc-ai.com')).toString().replace(/\/$/, '');
const canonical = pageAbsUrl(locale, resolvedSlug);
const ogImageUrl = `${siteOrigin}${assetPath('/images/modoc-ai-logo-dark.webp')}`;

const founderObj: Record<string, string> = {
  '@type': 'Person',
  name: dict.orgSchema.founderName,
  jobTitle: dict.orgSchema.founderJobTitle,
};
if (dict.orgSchema.founderHonorificSuffix) {
  founderObj.honorificSuffix = dict.orgSchema.founderHonorificSuffix;
}

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: dict.orgSchema.name,
  alternateName: dict.orgSchema.alternateName,
  url: pageAbsUrl(locale, ''),
  logo: ogImageUrl,
  description: dict.orgSchema.description,
  email: CONTACT_EMAIL,
  founder: founderObj,
  areaServed: ['KR', 'US'],
  sameAs: ['https://www.modoc-ai.com', 'https://www.fevercoach.us'],
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: dict.serviceSchema.name,
  provider: {
    '@type': 'Organization',
    name: dict.serviceSchema.providerName,
  },
  areaServed: meta.areaServed,
  serviceType: dict.serviceSchema.serviceType,
  url: pageAbsUrl(locale, 'services'),
};

const rawExtras = extraSchema
  ? Array.isArray(extraSchema)
    ? extraSchema
    : [extraSchema]
  : [];
const schemas = [orgSchema, serviceSchema, ...rawExtras];
---
<!doctype html>
<html lang={meta.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {LOCALES.map((loc) => (
      <link
        rel="alternate"
        hreflang={LOCALE_META[loc].htmlLang}
        href={pageAbsUrl(loc, resolvedSlug)}
      />
    ))}
    <link rel="alternate" hreflang="x-default" href={pageAbsUrl(DEFAULT_LOCALE, resolvedSlug)} />
    <link rel="icon" href={assetPath('/favicon.svg')} type="image/svg+xml" />
    <link
      rel="stylesheet"
      crossorigin
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="zicks · MoDoc AI" />
    <meta property="og:locale" content={meta.ogLocale} />
    {LOCALES.filter((l) => l !== locale).map((alt) => (
      <meta property="og:locale:alternate" content={LOCALE_META[alt].ogLocale} />
    ))}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary" />
    {schemas.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}
  </head>
  <body>
    <header class="site-header">
      <div class="container header-row">
        <a class="brand-link" href={pagePath(locale, '')}>
          zicks <small>{dict.brandSub}</small>
        </a>

        <div class="desktop-nav">
          <nav class="nav-links" aria-label={dict.aria.primaryNav}>
            {dict.nav.map((item) => (
              <a
                href={pagePath(locale, item.slug)}
                aria-current={resolvedSlug === item.slug ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))}
          </nav>

          <div class="header-actions">
            <div class="lang-switch" role="group" aria-label={dict.aria.langSwitcher}>
              {LOCALES.map((loc) => (
                <a
                  href={pagePath(loc, resolvedSlug)}
                  class={loc === locale ? 'active' : undefined}
                  aria-current={loc === locale ? 'true' : undefined}
                  lang={LOCALE_META[loc].htmlLang}
                  hreflang={LOCALE_META[loc].htmlLang}
                >
                  {LOCALE_META[loc].shortLabel}
                </a>
              ))}
            </div>
            <a class="header-cta" href={pagePath(locale, 'contact')}>
              {dict.ctaLabel}
            </a>
          </div>
        </div>

        <div class="mobile-actions">
          <a class="header-cta" href={pagePath(locale, 'contact')}>
            {dict.ctaLabel}
          </a>
          <button
            type="button"
            class="menu-toggle"
            id="menu-toggle-btn"
            aria-expanded="false"
            aria-controls="mobile-drawer"
            aria-label={dict.aria.openMenu}
            data-open-label={dict.aria.openMenu}
            data-close-label={dict.aria.closeMenu}
          >
            <svg id="icon-open" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
              <line x1="4" y1="7" x2="20" y2="7" />
              <line x1="4" y1="12" x2="20" y2="12" />
              <line x1="4" y1="17" x2="20" y2="17" />
            </svg>
            <svg id="icon-close" aria-hidden="true" style="display:none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
              <line x1="6" y1="6" x2="18" y2="18" />
              <line x1="18" y1="6" x2="6" y2="18" />
            </svg>
          </button>
        </div>
      </div>

      <div class="mobile-drawer" id="mobile-drawer">
        <nav class="mobile-nav-list" aria-label={dict.aria.mobileNav}>
          {dict.nav.map((item) => (
            <a
              href={pagePath(locale, item.slug)}
              aria-current={resolvedSlug === item.slug ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))}
        </nav>
        <div class="mobile-lang-row">
          <span>{dict.aria.langSwitcher}</span>
          <div class="lang-switch" role="group" aria-label={dict.aria.langSwitcher}>
            {LOCALES.map((loc) => (
              <a
                href={pagePath(loc, resolvedSlug)}
                class={loc === locale ? 'active' : undefined}
                aria-current={loc === locale ? 'true' : undefined}
                lang={LOCALE_META[loc].htmlLang}
                hreflang={LOCALE_META[loc].htmlLang}
              >
                {LOCALE_META[loc].nativeLabel}
              </a>
            ))}
          </div>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-top">
          <div>
            <div class="footer-brand">zicks</div>
            <div>{dict.footer.companyLine} · {dict.footer.tagline}</div>
            {dict.footer.addressLine && <div>{dict.footer.addressLine}</div>}
          </div>
          <nav class="footer-nav" aria-label={dict.aria.footerNav}>
            {dict.nav.map((item) => (
              <a href={pagePath(locale, item.slug)}>{item.label}</a>
            ))}
            <a href={pagePath(locale, 'contact')}>{dict.ctaLabel}</a>
          </nav>
        </div>

        <div class="footer-bottom">
          <div>
            {dict.footer.disclaimer}<br />
            {dict.footer.openWebNote}
          </div>
          <div class="footer-links-right">
            {dict.footer.contactLabel}: <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a><br />
            <a href="https://www.modoc-ai.com" rel="noopener">modoc-ai.com</a> ·{' '}
            <a href="https://www.fevercoach.us" rel="noopener">FeverCoach</a> ·{' '}
            <a href={assetPath('/llms.txt')}>llms.txt</a>
          </div>
        </div>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const btn = document.getElementById('menu-toggle-btn');
        const drawer = document.getElementById('mobile-drawer');
        const openIcon = document.getElementById('icon-open');
        const closeIcon = document.getElementById('icon-close');
        if (btn && drawer) {
          const setOpen = (open) => {
            drawer.classList.toggle('is-open', open);
            btn.setAttribute('aria-expanded', String(open));
            btn.setAttribute(
              'aria-label',
              open ? btn.dataset.closeLabel || 'Close' : btn.dataset.openLabel || 'Menu'
            );
            if (openIcon && closeIcon) {
              openIcon.style.display = open ? 'none' : 'block';
              closeIcon.style.display = open ? 'block' : 'none';
            }
          };

          btn.addEventListener('click', () => {
            setOpen(!drawer.classList.contains('is-open'));
          });

          document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && drawer.classList.contains('is-open')) {
              setOpen(false);
              btn.focus();
            }
          });
        }

        if (
          'IntersectionObserver' in window &&
          window.matchMedia('(prefers-reduced-motion: no-preference)').matches
        ) {
          const targets = document.querySelectorAll('.reveal-on-scroll');
          const vh = window.innerHeight || 800;
          const io = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-visible');
                  io.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.08 }
          );
          targets.forEach((el) => {
            const rect = el.getBoundingClientRect();
            if (rect.top > vh * 0.95) {
              el.classList.add('will-reveal');
              io.observe(el);
            }
          });
        }
      })();
    </script>
  </body>
</html>
