---
import HowPage from '../../components/HowPage.astro';
import PricingPage from '../../components/PricingPage.astro';
import ServicesPage from '../../components/ServicesPage.astro';
import SubpageBasic from '../../components/SubpageBasic.astro';
import { NON_DEFAULT_LOCALES, type Locale, type PageSlug } from '../../i18n';

export function getStaticPaths() {
  const slugs: Array<Exclude<PageSlug, ''>> = [
    'how',
    'services',
    'cases',
    'pricing',
    'contact',
  ];
  return NON_DEFAULT_LOCALES.flatMap((locale) =>
    slugs.map((slug) => ({
      params: { locale, slug },
    }))
  );
}

const { locale, slug } = Astro.params as {
  locale: Locale;
  slug: Exclude<PageSlug, ''>;
};
---
{slug === 'how' ? (
  <HowPage locale={locale} />
) : slug === 'services' ? (
  <ServicesPage locale={locale} />
) : slug === 'pricing' ? (
  <PricingPage locale={locale} />
) : (
  <SubpageBasic locale={locale} slug={slug} />
)}
