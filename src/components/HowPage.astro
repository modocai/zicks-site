---
import Base from '../layouts/Base.astro';
import { getDict, type Market } from '../i18n';
import BottomCta from './ui/BottomCta.astro';
import CompareTable from './ui/CompareTable.astro';
import Icon from './ui/Icon.astro';
import Lines from './ui/Lines.astro';
import SubHero from './ui/SubHero.astro';

const { market } = Astro.props as { market: Market };
const c = getDict(market).how;
const t = c.stepsTable;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: c.faq.items.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---
<Base market={market} slug="how" title={c.metaTitle} description={c.metaDescription} extraSchema={faqSchema}>
  <SubHero market={market} hero={c.hero} />

  <section class="sec sec-white">
    <div class="container">
      <h2><Lines text={t.heading} /></h2>
      <p class="sec-lead">{t.lead}</p>
      <div class="table-scroll table-gap">
        <table class="data-table steps-table">
          <thead>
            <tr>
              <th scope="col" class="col-step">{t.headers[0]}</th>
              <th scope="col">{t.headers[1]}</th>
              <th scope="col" class="col-owner">{t.headers[2]}</th>
              <th scope="col" class="col-output">{t.headers[3]}</th>
            </tr>
          </thead>
          <tbody>
            {t.rows.map((row, i) => (
              <tr class:list={[row.kind === 'review' && 'is-highlight']}>
                <td><span class={`step-dot is-${row.kind}`}>{i + 1}</span></td>
                <td>
                  <div class="cell-title">{row.title}</div>
                  <p class="cell-body">{row.body}</p>
                </td>
                <td class:list={['cell-owner', row.kind !== 'tool' && 'is-client']}>{row.owner}</td>
                <td class="cell-output">{row.output}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="sec sec-gray">
    <div class="container split">
      <div class="split-copy">
        <h2><Lines text={c.inputs.heading} /></h2>
        <p class="sec-lead">{c.inputs.lead}</p>
      </div>
      <div class="split-body row-list">
        {c.inputs.items.map((item) => (
          <div>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="sec sec-white">
    <div class="container">
      <h2><Lines text={c.principles.heading} /></h2>
      <p class="sec-lead">{c.principles.lead}</p>
      <div class="rule-cols has-topline">
        {c.principles.items.map((item) => (
          <div>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="sec sec-gray">
    <div class="container">
      <h2><Lines text={c.compare.heading} /></h2>
      {c.compare.lead && <p class="sec-lead">{c.compare.lead}</p>}
      <CompareTable compare={c.compare} />
    </div>
  </section>

  <section class="sec sec-white">
    <div class="container container-narrow">
      <h2><Lines text={c.faq.heading} /></h2>
      <div class="faq-list">
        {c.faq.items.map((item, i) => (
          <details open={i === 0}>
            <summary>
              {item.q}
              <Icon name="chevron" />
            </summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <BottomCta market={market} cta={c.bottomCta} />
</Base>
