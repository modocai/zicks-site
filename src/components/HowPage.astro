---
import Base from '../layouts/Base.astro';
import { getDict, pagePath, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDict(locale);
const c = dict.how;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: c.faq.items.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};
---
<Base
  locale={locale}
  slug="how"
  title={c.metaTitle}
  description={c.metaDescription}
  extraSchema={faqSchema}
>
  <!-- 상단 머리말 -->
  <section class="sub-hero">
    <div class="container">
      <span class="sec-eyebrow">{c.header.eyebrow}</span>
      <h1>
        {c.header.h1Lines.map((line, idx) => (
          <>
            {idx > 0 && <>{' '}<br class="desktop-br" /></>}
            {line}
          </>
        ))}
      </h1>
      <p class="sub-lead">{c.header.lead}</p>
    </div>
  </section>

  <!-- 1. 핵심 4단계 운영 루프 스플릿 블록 -->
  <section class="sec-white">
    <div class="container">
      <div class="split-showcase">
        <div>
          <span class="bento-chip purple">{c.loopBlock.chip}</span>
          <h2>{c.loopBlock.heading}</h2>
          <p class="split-body">{c.loopBlock.body}</p>
          <div class="btn-row">
            <a class="btn-solid btn-sm" href={pagePath(locale, 'contact')}>
              {dict.ctaLabel}
            </a>
            <a class="btn-tint btn-sm" href={pagePath(locale, 'services')}>
              {c.bottomNav.nextLabel}
            </a>
          </div>
        </div>

        <figure class="ui-panel" aria-label={c.loopBlock.mockBadge}>
          <div class="ui-panel-head">
            <span class="ui-panel-title">{c.loopBlock.mockBadge}</span>
          </div>
          <div class="step-card-list">
            {c.loopBlock.steps.map((st) => (
              <div class={`step-card-item${st.isHuman ? ' is-human' : ''}`}>
                <div class="step-card-top">
                  <span class="step-card-name">
                    <span class="step-num-tag">{st.num}</span>
                    {st.title}
                  </span>
                  <span class={`role-pill ${st.isHuman ? 'human' : 'auto'}`}>
                    {st.role}
                  </span>
                </div>
                <p class="step-card-desc">{st.desc}</p>
              </div>
            ))}
          </div>
        </figure>
      </div>
    </div>
  </section>

  <!-- 2. 질문 20개 구성 / 시작 입력 자료 -->
  <section class="sec-light reveal-on-scroll">
    <div class="container">
      <div class="sec-head">
        <span class="sec-eyebrow">{c.composition.eyebrow}</span>
        <h2>{c.composition.heading}</h2>
        <p>{c.composition.lead}</p>
      </div>

      <div class="comp-grid">
        {c.composition.items.map((item) => (
          <article class="comp-card">
            <span class="pill">{item.tag}</span>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. 원고 · 검수 · 게시 3규격 -->
  <section class="sec-white reveal-on-scroll">
    <div class="container">
      <div class="sec-head">
        <span class="sec-eyebrow purple">{c.craft.eyebrow}</span>
        <h2>{c.craft.heading}</h2>
        <p>{c.craft.lead}</p>
      </div>

      <div class="offers-grid">
        {c.craft.cards.map((card) => (
          <article class="offer-card">
            <div>
              <span class="pill">{card.badge}</span>
              <h3>{card.title}</h3>
              <p class="offer-summary">{card.body}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. 기존 대행 vs zicks 좌우 대비 블록 -->
  <section class="sec-light reveal-on-scroll">
    <div class="container">
      <div class="sec-head">
        <span class="sec-eyebrow">{c.comparison.eyebrow}</span>
        <h2>{c.comparison.heading}</h2>
      </div>

      <div class="versus-list">
        {c.comparison.rows.map((row) => (
          <div class="versus-row">
            <div class="versus-topic">{row.topic}</div>
            <div class="versus-col legacy">
              <span class="versus-col-label">{c.comparison.legacyTitle}</span>
              {row.legacy}
            </div>
            <div class="versus-col zicks">
              <span class="versus-col-label">{c.comparison.zicksTitle}</span>
              {row.zicks}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. FAQ 아코디언 (FAQPage JSON-LD 자동 동기화) -->
  <section class="sec-white reveal-on-scroll">
    <div class="container">
      <div class="sec-head">
        <span class="sec-eyebrow purple">{c.faq.eyebrow}</span>
        <h2>{c.faq.heading}</h2>
      </div>

      <div class="faq-list">
        {c.faq.items.map((item, idx) => (
          <details class="faq-item" open={idx === 0}>
            <summary>
              <span>{item.q}</span>
              <span class="faq-icon" aria-hidden="true">+</span>
            </summary>
            <div class="faq-answer">{item.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 6. 하단 배너 + 다음 페이지 안내 -->
  <section class="bottom-banner-sec reveal-on-scroll">
    <div class="container">
      <div class="cta-banner">
        <h2>{c.bottomNav.heading}</h2>
        <p>{c.bottomNav.lead}</p>
        <div class="banner-btns">
          <a class="btn-solid" href={pagePath(locale, 'contact')}>
            {dict.ctaLabel}
          </a>
          <a class="btn-on-dark" href={pagePath(locale, c.bottomNav.nextSlug)}>
            {c.bottomNav.nextLabel}
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>
