---
import Base from '../layouts/Base.astro';
import { getDict, type Market } from '../i18n';
import BottomCta from './ui/BottomCta.astro';
import CheckList from './ui/CheckList.astro';
import Lines from './ui/Lines.astro';
import StepList from './ui/StepList.astro';
import SubHero from './ui/SubHero.astro';

const { market } = Astro.props as { market: Market };
const c = getDict(market).pricing;
const t = c.table;
---
<Base market={market} slug="pricing" title={c.metaTitle} description={c.metaDescription}>
  <SubHero market={market} hero={c.hero} />

  <section class="sec sec-white">
    <div class="container">
      <h2><Lines text={t.heading} /></h2>
      <div class="table-scroll table-gap-sm">
        <table class="data-table price-table">
          <thead>
            <tr>
              <th scope="col">{t.headers[0]}</th>
              <th scope="col" class="col-audience">{t.headers[1]}</th>
              <th scope="col" class="col-unit">{t.headers[2]}</th>
              <th scope="col" class="num col-price">{t.headers[3]}</th>
            </tr>
          </thead>
          <tbody>
            {t.rows.map((row) => (
              <tr class:list={[row.highlight && 'is-highlight']}>
                <th scope="row">
                  {row.name}
                  {row.sub && <div class="cell-sub">{row.sub}</div>}
                </th>
                <td>{row.audience}</td>
                <td>{row.unit}</td>
                <td class="num cell-price">
                  {row.price}
                  {row.per && <span class="cell-per">{row.per}</span>}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="small-note">{t.note}</p>
    </div>
  </section>

  <section class="sec sec-gray">
    <div class="container">
      <h2><Lines text={c.plans.heading} /></h2>
      <div class="rule-cols has-topline is-plans">
        {c.plans.items.map((plan) => (
          <div>
            <h3>{plan.title}</h3>
            <p>{plan.summary}</p>
            <CheckList items={plan.points} />
            {plan.foot && (
              <p class="foot-line">
                {plan.foot.label && <><strong>{plan.foot.label}</strong>&nbsp; </>}
                {plan.foot.text}
              </p>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="sec sec-white">
    <div class="container">
      <h2><Lines text={c.flow.heading} /></h2>
      <StepList items={c.flow.items} />
      <p class="promise-line">{c.flow.promise}</p>
    </div>
  </section>

  <BottomCta market={market} cta={c.bottomCta} />
</Base>
