---
import Base from '../layouts/Base.astro';
import {
  CONTACT_EMAIL,
  getDict,
  pagePath,
  type Locale,
  type PageSlug,
} from '../i18n';

interface Props {
  locale: Locale;
  slug: Exclude<PageSlug, ''>;
}

const { locale, slug } = Astro.props;
const dict = getDict(locale);
const sub = dict.subpages?.[slug];
if (!sub) {
  throw new Error(`Missing subpage data for ${locale}/${slug}`);
}

const mailtoHref = `mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent(
  dict.inquiryMailto.subject
)}&body=${encodeURIComponent(dict.inquiryMailto.body)}`;
---
<Base
  locale={locale}
  slug={slug}
  title={sub.metaTitle}
  description={sub.metaDescription}
>
  <section class="subpage-sec">
    <div class="container">
      <span class="sec-eyebrow">{sub.eyebrow}</span>
      <h1>{sub.h1}</h1>
      <p class="lead">{sub.lead}</p>

      <div class="grid g3">
        {sub.cards.map((c) => (
          <article class="card">
            {c.badge && <span class="pill">{c.badge}</span>}
            <h3>{c.title}</h3>
            <p>{c.body}</p>
          </article>
        ))}
      </div>

      {sub.note && <p class="note" style="margin-top:22px">{sub.note}</p>}

      <div class="btn-row" style="margin-top:28px">
        {slug === 'contact' ? (
          <a class="btn-solid" href={mailtoHref}>
            {dict.ctaLabel} ({CONTACT_EMAIL})
          </a>
        ) : (
          <>
            <a class="btn-solid" href={pagePath(locale, 'contact')}>
              {dict.ctaLabel}
            </a>
            {sub.nextLink && (
              <a class="btn-tint" href={pagePath(locale, sub.nextLink.slug)}>
                {sub.nextLink.label}
              </a>
            )}
          </>
        )}
      </div>
    </div>
  </section>
</Base>
