---
import Base from '../layouts/Base.astro';
import { getDict, linkHref, type Market } from '../i18n';
import BottomCta from './ui/BottomCta.astro';
import CheckList from './ui/CheckList.astro';
import CompareTable from './ui/CompareTable.astro';
import Icon from './ui/Icon.astro';
import Lines from './ui/Lines.astro';
import StepList from './ui/StepList.astro';

const { market } = Astro.props as { market: Market };
const c = getDict(market).home;
const panel = c.hero.panel;
const doc = c.audit.doc;
---
<Base market={market} slug="" title={c.metaTitle} description={c.metaDescription}>
  <div class="home">
    <section class="home-hero">
      <div class="home-hero-inner">
        <div class="home-hero-copy">
          <h1><Lines text={c.hero.title} /></h1>
          <p class="hero-lead">{c.hero.lead}</p>
          <div class="btn-row">
            <a class="btn-solid" href={linkHref(market, c.hero.primary)}>{c.hero.primary.label}</a>
            <a class="btn-tint" href={linkHref(market, c.hero.secondary)}>{c.hero.secondary.label}</a>
          </div>
          <p class="hero-note">{c.hero.note}</p>
        </div>

        <div class="home-hero-visual">
          <figure class="panel" aria-label={panel.ariaLabel}>
            <div class="panel-bar">
              <div class="panel-tabs">
                {panel.tabs.map((tab, i) => <span class:list={[i === 0 && 'is-active']}>{tab}</span>)}
              </div>
              <div class="panel-meta">
                <span class="chip-sample">{panel.sampleBadge}</span>
                <span class="panel-context">
                  {panel.context}
                  {panel.contextMenu && <Icon name="chevron-sm" />}
                </span>
              </div>
            </div>

            <div class="panel-summary">
              {panel.summary.map((s) => (
                <div>
                  <div class="summary-label">{s.label}</div>
                  <div class="summary-value">{s.value}</div>
                  <div class:list={['summary-note', s.accent && 'is-accent']}>{s.note}</div>
                </div>
              ))}
            </div>

            <div class="table-scroll">
              <table class="panel-table">
                <thead>
                  <tr>
                    <th scope="col">{panel.questionHeader}</th>
                    {panel.engines.map((engine, i) => (
                      <th scope="col" class:list={[i === panel.highlightEngine && 'is-strong']}>{engine}</th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {panel.rows.map((row) => (
                    <tr class:list={[row.topic && 'is-topic']}>
                      <th scope="row">
                        <div class="panel-q">{row.q}</div>
                        <div class="panel-tags">
                          <span>{row.tag}</span>
                          {row.topic && <span class="panel-topic">{row.topic}</span>}
                        </div>
                      </th>
                      {row.marks.map((mark) => (
                        <td>
                          {mark === 'none' ? (
                            panel.markLabels.none
                          ) : (
                            <span class={`mark mark-${mark}`}>{panel.markLabels[mark]}</span>
                          )}
                        </td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            <div class="panel-legend">
              <span><strong>{panel.markLabels.cited}</strong>&nbsp; {panel.legend.cited}</span>
              <span><strong>{panel.markLabels.named}</strong>&nbsp; {panel.legend.named}</span>
            </div>
          </figure>
        </div>
      </div>
    </section>

    <section class="sec sec-white">
      <div class="container split split-center">
        <div class="split-copy">
          <h2><Lines text={c.audit.heading} /></h2>
          <p class="sec-lead">{c.audit.lead}</p>
          <a class="text-link" href={linkHref(market, c.audit.link)}>{c.audit.link.label}</a>
        </div>
        <article class="audit-doc" aria-label={doc.ariaLabel}>
          <div class="doc-head">
            <div>
              <div class="doc-title">{doc.title}</div>
              <div class="doc-meta">{doc.meta}</div>
            </div>
            <span class="chip-sample">{doc.badge}</span>
          </div>
          <ol class="doc-items">
            {doc.items.map((item, i) => (
              <li>
                <span class="doc-num">{i + 1}</span>
                <div>
                  <div class="doc-item-title">{item.title}</div>
                  <div class="doc-scope">{item.scope}</div>
                  <div class="doc-finding">{item.finding}</div>
                </div>
                <span class={`status status-${item.tone}`}>{item.status}</span>
              </li>
            ))}
          </ol>
          <p class="doc-next"><strong>{doc.next.label}</strong>&nbsp; {doc.next.text}</p>
        </article>
      </div>
    </section>

    <section class="sec sec-gray">
      <div class="container">
        <div class="sec-head-center">
          <h2 class="h2-lg"><Lines text={c.steps.heading} /></h2>
          <p class="sec-lead">{c.steps.lead}</p>
        </div>
        <StepList items={c.steps.items} />
      </div>
    </section>

    <section class="sec sec-dark">
      <div class="container">
        <div class="proof-head">
          <div class="proof-copy">
            <h2 class="h2-lg"><Lines text={c.proof.heading} /></h2>
            <p class="sec-lead">{c.proof.lead}</p>
          </div>
          <a class="text-link" href={linkHref(market, c.proof.link)}>{c.proof.link.label}</a>
        </div>
        <div class="proof-stats">
          {c.proof.stats.map((s) => (
            <div class="proof-stat">
              <div class="proof-label">{s.label}</div>
              <div class="proof-value">{s.value}</div>
              <div class="proof-change">{s.change}</div>
              <div class="proof-source">{s.source}</div>
            </div>
          ))}
        </div>
        <p class="proof-note">{c.proof.note}</p>
      </div>
    </section>

    {c.pricing && (
      <section class="sec sec-white">
        <div class="container split">
          <div class="split-copy">
            <h2><Lines text={c.pricing.heading} /></h2>
            <p class="sec-lead">{c.pricing.lead}</p>
            <div class="big-price">{c.pricing.price}</div>
            <div class="big-price-note">{c.pricing.priceNote}</div>
            <a class="btn-solid big-price-btn" href={linkHref(market, c.pricing.button)}>{c.pricing.button.label}</a>
          </div>
          <div class="split-body">
            <h3 class="rule-title">{c.pricing.includedTitle}</h3>
            <CheckList items={c.pricing.included} variant="rows" />
            <h3 class="rule-title">{c.pricing.excludedTitle}</h3>
            <p class="rule-text">{c.pricing.excluded}</p>
            <h3 class="rule-title">{c.pricing.afterTitle}</h3>
            <p class="rule-text is-last">{c.pricing.after}</p>
          </div>
        </div>
      </section>
    )}

    {c.compare && (
      <section class="sec sec-white">
        <div class="container">
          <div class="sec-head-center">
            <h2 class="h2-lg"><Lines text={c.compare.heading} /></h2>
            {c.compare.lead && <p class="sec-lead">{c.compare.lead}</p>}
          </div>
          <CompareTable compare={c.compare} />
        </div>
      </section>
    )}

    <BottomCta market={market} cta={c.bottomCta} />
  </div>
</Base>
