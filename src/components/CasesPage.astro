---
import Base from '../layouts/Base.astro';
import { getDict, type Market } from '../i18n';
import BottomCta from './ui/BottomCta.astro';
import Lines from './ui/Lines.astro';
import SubHero from './ui/SubHero.astro';

const { market } = Astro.props as { market: Market };
const c = getDict(market).cases;
const m = c.metrics;
---
<Base market={market} slug="cases" title={c.metaTitle} description={c.metaDescription}>
  <SubHero market={market} hero={c.hero}>
    <div class="logo-row">
      <span class="logo-fevercoach">
        <img src="/images/fevercoach_Logo-without-background.png" alt="" width="36" height="36" />
        <span>FeverCoach</span>
      </span>
      <img class="logo-modoc" src="/images/modoc-ai-logo-light.webp" alt="MoDoc AI" height="30" />
    </div>
  </SubHero>

  <section class="sec sec-white">
    <div class="container split">
      <div class="split-copy">
        <h2><Lines text={c.about.heading} /></h2>
        <p class="sec-lead">{c.about.lead}</p>
      </div>
      {c.about.facts && (
        <dl class="split-body def-list">
          {c.about.facts.map((fact) => (
            <div>
              <dt>{fact.term}</dt>
              <dd>
                {fact.desc}
                {fact.link && <>{' '}<a href={fact.link.href} rel="noopener">{fact.link.label}</a></>}
              </dd>
            </div>
          ))}
        </dl>
      )}
    </div>
    <div class="container metrics-block">
      <h3 class="h3-lg">{m.heading}</h3>
      <div class="table-scroll">
        <table class="data-table metrics-table">
          <thead>
            <tr>
              <th scope="col">{m.headers[0]}</th>
              <th scope="col" class="num col-before">{m.headers[1]}</th>
              <th scope="col" class="num col-after">{m.headers[2]}</th>
              <th scope="col" class="col-period">{m.headers[3]}</th>
              <th scope="col" class="col-source">{m.headers[4]}</th>
            </tr>
          </thead>
          <tbody>
            {m.rows.map((row) => (
              <tr>
                <th scope="row">
                  {row.label}
                  {row.sub && <div class="cell-sub">{row.sub}</div>}
                </th>
                <td class="num">{row.before}</td>
                <td class="num cell-after">{row.after}</td>
                <td>{row.period}</td>
                <td>{row.source}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="small-note">{m.note}</p>
    </div>
  </section>

  <section class="sec sec-gray">
    <div class="container split">
      <div class="split-copy">
        <h2><Lines text={c.site.heading} /></h2>
        <p class="sec-lead">{c.site.lead}</p>
      </div>
      <div class="split-body row-list has-topline">
        {c.site.items.map((item) => (
          <div>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
            {item.link && <a class="text-link" href={item.link.asset}>{item.link.label}</a>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <BottomCta market={market} cta={c.closing} tone="white" />
</Base>
