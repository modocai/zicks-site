---
/* 시안에서 쓰는 아이콘 넷. 모두 장식이므로 aria-hidden */
const { name } = Astro.props as { name: 'check' | 'x' | 'chevron' | 'chevron-sm' };
---
{name === 'check' && (
  <svg class="icon-check" aria-hidden="true" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3.5 9.5L7.2 13L14.5 5" /></svg>
)}
{name === 'x' && (
  <svg class="icon-x" aria-hidden="true" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4.5 4.5L13.5 13.5M13.5 4.5L4.5 13.5" /></svg>
)}
{name === 'chevron' && (
  <svg class="icon-chevron" aria-hidden="true" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 6.75L9 11.25L13.5 6.75" /></svg>
)}
{name === 'chevron-sm' && (
  <svg aria-hidden="true" width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 4.5L6 7.5L9 4.5" /></svg>
)}
