---
import type { Step } from '../../i18n';

/* 가로 4단 단계 목록. 원 채움: tool=테두리(인디고), review=채움, team=테두리(진한 인디고) */
const { items } = Astro.props as { items: Step[] };
---
<ol class="step-list">
  {items.map((step, i) => (
    <li>
      <div class="step-top">
        <span class={`step-dot is-${step.kind}`}>{i + 1}</span>
        {i < items.length - 1 && <span class="step-line" aria-hidden="true" />}
      </div>
      {step.role && <div class:list={['step-role', step.kind !== 'tool' && 'is-client']}>{step.role}</div>}
      <h3>{step.title}</h3>
      <p>{step.body}</p>
    </li>
  ))}
</ol>
