---
import Base from '../layouts/Base.astro';
import { getDict, linkHref, type Market } from '../i18n';
import BottomCta from './ui/BottomCta.astro';
import CheckList from './ui/CheckList.astro';
import Lines from './ui/Lines.astro';
import SubHero from './ui/SubHero.astro';

const { market } = Astro.props as { market: Market };
const c = getDict(market).services;
const other = c.offers.other;
---
<Base market={market} slug="services" title={c.metaTitle} description={c.metaDescription}>
  <SubHero market={market} hero={c.hero} />

  <section class="sec sec-white">
    <div class="container split">
      <div class="split-copy">
        <h2><Lines text={c.roles.heading} /></h2>
        <p class="sec-lead">{c.roles.lead}</p>
      </div>
      <div class="split-body">
        <table class="data-table roles-table">
          <caption>{c.roles.caption}</caption>
          <thead>
            <tr>
              <th scope="col">{c.roles.headers[0]}</th>
              <th scope="col" class="col-owner">{c.roles.headers[1]}</th>
            </tr>
          </thead>
          <tbody>
            {c.roles.rows.map((row) => (
              <tr>
                <td>{row.task}</td>
                <td class:list={['cell-owner', row.client && 'is-client']}>{row.owner}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="small-note">{c.roles.note}</p>
      </div>
    </div>
  </section>

  <section class="sec sec-gray">
    <div class="container">
      <h2><Lines text={c.offers.heading} /></h2>
      <p class="sec-lead">{c.offers.lead}</p>
      <div class="offer-rows">
        {c.offers.items.map((item) => (
          <div class="offer-row">
            <div class="offer-copy">
              <h3>{item.title}</h3>
              <p class="offer-meta">{item.meta}</p>
              <p class="offer-summary">{item.summary}</p>
            </div>
            <div class="offer-body">
              <CheckList items={item.points} />
              {item.foot && (
                <p class="foot-line">
                  {item.foot.label && <><strong>{item.foot.label}</strong>&nbsp; </>}
                  {item.foot.text}
                </p>
              )}
            </div>
          </div>
        ))}
      </div>

      {other && (
        <div class="other-box" id={other.id}>
          <div class="other-copy">
            <h3>{other.title}</h3>
            <p>{other.body}</p>
          </div>
          <div class="other-body">
            <dl class="def-list is-compact">
              {other.rows.map((row) => (
                <div>
                  <dt>{row.label}</dt>
                  <dd>{row.value}</dd>
                </div>
              ))}
            </dl>
            <a class="text-link" href={linkHref(market, other.link)}>{other.link.label}</a>
          </div>
        </div>
      )}
    </div>
  </section>

  <section class="sec sec-white">
    <div class="container">
      <h2><Lines text={c.boundaries.heading} /></h2>
      <div class="rule-cols is-two">
        <div>
          <h3 class="rule-title">{c.boundaries.notTitle}</h3>
          <CheckList items={c.boundaries.notItems} variant="x" />
        </div>
        <div>
          <h3 class="rule-title">{c.boundaries.yesTitle}</h3>
          <CheckList items={c.boundaries.yesItems} variant="rows" />
        </div>
      </div>
      <p class="sec-note">{c.boundaries.note}</p>
    </div>
  </section>

  <BottomCta market={market} cta={c.bottomCta} />
</Base>
