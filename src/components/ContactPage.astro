---
import Base from '../layouts/Base.astro';
import { CONTACT_EMAIL, getDict, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDict(locale);
const c = dict.contact;

const mailtoHref = `mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent(
  dict.inquiryMailto.subject
)}&body=${encodeURIComponent(dict.inquiryMailto.body)}`;
---
<Base
  locale={locale}
  slug="contact"
  title={c.metaTitle}
  description={c.metaDescription}
>
  <!-- 상단 머리말 -->
  <section class="sub-hero">
    <div class="container">
      <span class="sec-eyebrow">{c.header.eyebrow}</span>
      <h1>
        {c.header.h1Lines.map((line, idx) => (
          <>
            {idx > 0 && <>{' '}<br class="desktop-br" /></>}
            {line}
          </>
        ))}
      </h1>
      <p class="sub-lead">{c.header.lead}</p>
      <ul class="trust-list">
        {c.reassurance.map((pt) => (
          <li>{pt}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 메인 2열: 좌측 즉시 문의 패널 + 우측 1장 진단서 구성 안내 -->
  <section class="sec-white">
    <div class="container">
      <div class="contact-grid">
        <!-- 좌측 액션 패널 -->
        <div class="contact-panel">
          <span class="pill">{c.actionCard.badge}</span>
          <div class="email-display-box">
            <span class="email-display-label">{c.actionCard.emailLabel}</span>
            <a class="email-address-text" href={mailtoHref}>{CONTACT_EMAIL}</a>
          </div>

          <div class="btn-row" style="margin-bottom:26px">
            <a class="btn-solid" href={mailtoHref}>
              {c.actionCard.composeBtn}
            </a>
            <button
              type="button"
              class="btn-tint"
              id="copy-email-btn"
              data-email={CONTACT_EMAIL}
              data-default={c.actionCard.copyBtn}
              data-copied={c.actionCard.copiedBtn}
            >
              {c.actionCard.copyBtn}
            </button>
          </div>
          <span id="copy-status" class="sr-only" aria-live="polite"></span>

          <!-- 웹메일 사용자용 양식 안내 -->
          <div class="template-guide-box">
            <h2 class="contact-subhead">{c.actionCard.templateTitle}</h2>
            <ol>
              {c.actionCard.templateItems.map((item) => (
                <li>{item}</li>
              ))}
            </ol>
          </div>

          <!-- 담당자 실명 확인 카드 -->
          <div class="reviewer-card">
            <span class="bento-chip purple" style="margin-bottom:8px">
              {c.actionCard.reviewerBadge}
            </span>
            <h2 class="contact-reviewer-head">{c.actionCard.reviewerTitle}</h2>
            <p>{c.actionCard.reviewerBody}</p>
          </div>
        </div>

        <!-- 우측 1장 진단서 구성 안내 -->
        <figure class="mock-window contact-audit-mock">
          <div class="mock-topbar">
            <div class="mock-dots">
              <span class="dots-decor" aria-hidden="true">
                <i></i><i></i><i></i>
              </span>
              <span class="sample-pill" style="background:var(--bg-white)">
                {c.auditMock.sampleBadge}
              </span>
            </div>
            <span class="mock-tag">{c.auditMock.windowTag}</span>
          </div>

          <h2 class="audit-mock-title">{c.auditMock.title}</h2>

          <div class="step-card-list">
            {c.auditMock.rows.map((row) => (
              <div class="step-card-item">
                <div class="step-card-top">
                  <span class="step-card-name">
                    <span class="step-num-tag">{row.num}</span>
                    {row.title}
                  </span>
                  <span class="role-pill auto">{row.status}</span>
                </div>
                <p class="step-card-desc">{row.detail}</p>
              </div>
            ))}
          </div>

          <figcaption class="mock-footnote">{c.auditMock.footnote}</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <script>
    (() => {
      const btn = document.getElementById('copy-email-btn') as HTMLButtonElement | null;
      const live = document.getElementById('copy-status');
      if (!btn) return;
      let timer: ReturnType<typeof setTimeout> | undefined;

      const fallbackCopy = (text: string): boolean => {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.setAttribute('readonly', '');
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        const ok = document.execCommand('copy');
        document.body.removeChild(ta);
        return ok;
      };

      btn.addEventListener('click', async () => {
        const email = btn.dataset.email || 'admin@modoc-ai.com';
        const copiedLabel = btn.dataset.copied || '✓ Copied';
        const defaultLabel = btn.dataset.default || 'Copy';
        let copied = false;

        if (navigator.clipboard && navigator.clipboard.writeText) {
          try {
            await navigator.clipboard.writeText(email);
            copied = true;
          } catch {
            copied = fallbackCopy(email);
          }
        } else {
          copied = fallbackCopy(email);
        }

        if (copied) {
          btn.textContent = copiedLabel;
          btn.classList.add('is-copied');
          if (live) live.textContent = copiedLabel;
          clearTimeout(timer);
          timer = setTimeout(() => {
            btn.textContent = defaultLabel;
            btn.classList.remove('is-copied');
            if (live) live.textContent = '';
          }, 2200);
        }
      });
    })();
  </script>
</Base>
