---
import Base from '../layouts/Base.astro';
import { CONTACT_EMAIL, getDict, type Market } from '../i18n';
import Lines from './ui/Lines.astro';

const { market } = Astro.props as { market: Market };
const c = getDict(market).contact;
const h = c.hero;
const composeHref = `mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent(h.mailSubject)}&body=${encodeURIComponent(h.mailBody)}`;
---
<Base market={market} slug="contact" title={c.metaTitle} description={c.metaDescription}>
  <section class="sub-hero contact-hero">
    <div class="container split">
      <div class="contact-copy">
        <h1><Lines text={h.title} /></h1>
        <p class="hero-lead">{h.lead}</p>
        <div class="contact-email">
          <div class="contact-email-label">{h.emailLabel}</div>
          <a class="contact-email-address" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
          <div class="btn-row">
            <a class="btn-solid" href={composeHref}>{h.composeLabel}</a>
            <button
              type="button"
              class="btn-tint"
              id="copy-email-btn"
              data-email={CONTACT_EMAIL}
              data-default={h.copyLabel}
              data-copied={h.copiedLabel}
            >
              {h.copyLabel}
            </button>
            <span id="copy-status" class="sr-only" aria-live="polite"></span>
          </div>
          <p class="hero-note">{h.composeNote}</p>
        </div>
      </div>

      <div class="contact-box">
        <h2>{c.box.title}</h2>
        <ol class="numbered-list">
          {c.box.items.map((item, i) => (
            <li>
              <span class="numbered-num">{i + 1}</span>
              <span>{item}</span>
            </li>
          ))}
        </ol>
        <p class="box-note">{c.box.note}</p>
        <div class="reviewer">
          <div class="reviewer-label">{c.box.reviewerLabel}</div>
          <div class="reviewer-name">{c.box.reviewerName}</div>
          <div class="reviewer-info"><Lines text={c.box.reviewerInfo} /></div>
        </div>
      </div>
    </div>
  </section>

  <section class="sec sec-white">
    <div class="container split">
      <div class="split-copy">
        <h2><Lines text={c.audit.heading} /></h2>
        <p class="sec-lead">{c.audit.lead}</p>
      </div>
      <div class="split-body">
        <table class="data-table audit-table">
          <thead>
            <tr>
              <th scope="col" class="col-item">{c.audit.headers[0]}</th>
              <th scope="col">{c.audit.headers[1]}</th>
            </tr>
          </thead>
          <tbody>
            {c.audit.rows.map((row) => (
              <tr>
                <th scope="row">{row.title}</th>
                <td>{row.detail}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="sec-note">{c.audit.note}</p>
      </div>
    </div>
  </section>

  <script>
    const btn = document.getElementById('copy-email-btn') as HTMLButtonElement | null;
    const live = document.getElementById('copy-status');
    let timer: ReturnType<typeof setTimeout> | undefined;

    const fallbackCopy = (text: string): boolean => {
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.setAttribute('readonly', '');
      ta.className = 'sr-only';
      document.body.appendChild(ta);
      ta.select();
      const ok = document.execCommand('copy');
      document.body.removeChild(ta);
      return ok;
    };

    btn?.addEventListener('click', async () => {
      const email = btn.dataset.email ?? '';
      let copied = false;
      try {
        await navigator.clipboard.writeText(email);
        copied = true;
      } catch {
        copied = fallbackCopy(email);
      }
      if (!copied) return;
      btn.textContent = btn.dataset.copied ?? '';
      btn.classList.add('is-copied');
      if (live) live.textContent = btn.dataset.copied ?? '';
      clearTimeout(timer);
      timer = setTimeout(() => {
        btn.textContent = btn.dataset.default ?? '';
        btn.classList.remove('is-copied');
        if (live) live.textContent = '';
      }, 2200);
    });
  </script>
</Base>
